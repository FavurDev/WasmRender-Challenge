{
  "name": "webgl-bench",
  "version": "0.1.0",
  "description": "Integration test suite for a pure JS/WASM WebGL software renderer.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-renderer.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:conformance": "vitest run tests/conformance",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'no linter configured'",
    "smoke": "tsx scripts/glsl-smoke.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.3",
    "@types/sharp": "^0.32.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.12",
    "playwright": "^1.52.0",
    "sharp": "^0.33.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
